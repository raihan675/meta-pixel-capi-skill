          {
            "type": "template",
            "key": "javascript",
            "value": "function() {\n  var items = {{DLV - Items}};\n  if (!items || !items.length) {\n    return '';\n  }\n  return items.map(function(item) {\n    return item.item_name || item.name || '';\n  }).filter(Boolean).join(', ');\n}"
