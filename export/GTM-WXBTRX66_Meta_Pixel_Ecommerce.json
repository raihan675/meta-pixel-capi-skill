          {
            "type": "template",
            "key": "javascript",
            "value": "function() {\n  var items = {{DLV - Items}};\n  if (!items || !items.length) {\n    return 1;\n  }\n  return items.reduce(function(total, item) {\n    var qty = parseInt(item.quantity, 10);\n    return total + (isNaN(qty) ? 1 : qty);\n  }, 0);\n}"
